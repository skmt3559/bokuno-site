# 本番サーバー（ロリポップ）用の設定。GitHub Pages では使われない。
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset UTF-8

# ブラウザ側の基本的な防御（種類の誤認識、他サイトへの埋め込み、通信の盗み見への対策）
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>

# ページ本体はサーバー側（ロリポップのアクセラレータ）にもブラウザにも溜めない。更新をすぐ反映させるため
<IfModule mod_headers.c>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>

# 表示を速くする：圧縮と、写真・動画などのブラウザ保存
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 10 minutes"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 hour"
ExpiresByType text/javascript "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/gif "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# 本番ドメインでは https・www なしに揃える（確認用の仮アドレスでは何もしない）
RewriteCond %{HTTP_HOST} ^(www\.)?bokuno-tuyatuya\.com$ [NC]
RewriteCond %{HTTPS} !on
RewriteRule ^ https://bokuno-tuyatuya.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.bokuno-tuyatuya\.com$ [NC]
RewriteRule ^ https://bokuno-tuyatuya.com%{REQUEST_URI} [R=301,L]

# レンタルサーバーの初期アドレス（○○.floppy.jp/bokuno-tuyatuya.com/…）で開かれたら、正式なアドレスへ送る
RewriteCond %{HTTP_HOST} !^(www\.)?bokuno-tuyatuya\.com$ [NC]
RewriteCond %{REQUEST_URI} ^/bokuno-tuyatuya\.com/?(.*)$
RewriteRule ^ https://bokuno-tuyatuya.com/%1 [R=301,L]

# お問い合わせの送信プログラム以外の PHP は動かさない（万一ファイルを置かれても実行させない）
RewriteCond %{REQUEST_URI} !/inquiry/send\.php$
RewriteRule \.(php|phtml|phar|cgi|pl)$ - [F,L,NC]

# 旧サイト（WordPress）にあった応募フォームのURLは、求人ページへ案内する
RewriteRule ^recruit/recruit-form/?$ /recruit/ [R=301,L]
RewriteRule ^top/recruit/recruit-form/?$ /recruit/ [R=301,L]
RewriteRule ^求人フォーム/?$ /recruit/ [R=301,L]
RewriteRule ^top/?$ / [R=301,L]
</IfModule>
